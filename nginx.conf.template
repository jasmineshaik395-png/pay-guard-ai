worker_processes auto;
pid ${NGINX_TMP}/nginx.pid;
error_log stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    error_log stderr notice;
    client_body_temp_path ${NGINX_TMP}/client_body;
    proxy_temp_path ${NGINX_TMP}/proxy;
    fastcgi_temp_path ${NGINX_TMP}/fastcgi;
    uwsgi_temp_path ${NGINX_TMP}/uwsgi;
    scgi_temp_path ${NGINX_TMP}/scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream payguard_streamlit {
        server 127.0.0.1:${STREAMLIT_PORT};
        keepalive 32;
    }

    server {
        listen ${PORT};
        server_name _;

        location = /manus-routes.json {
            root ${APP_DIR}/public;
            default_type application/json;
            add_header Cache-Control "no-cache" always;
            try_files /manus-routes.json =404;
        }

        location = /healthz {
            proxy_pass http://payguard_streamlit/_stcore/health;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        }

        location / {
            proxy_pass http://payguard_streamlit;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
            proxy_buffering off;
        }
    }
}
